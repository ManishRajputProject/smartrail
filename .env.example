NEXT_PUBLIC_SUPABASE_URL=
# Server-only (no NEXT_PUBLIC_ prefix) — all writes go through Route Handlers.
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Train data (RailRadar) ---------------------------------------------
# Server-only, never exposed to the browser. From RailRadar dashboard ->
# Plans -> your active plan's key (Bearer rr_live_...).
RAILRADAR_API_KEY=

# --- Reminder emails -----------------------------------------------------
# From resend.com (free tier: 3,000 emails/month). Required for the
# reminders cron sweep to actually send anything — without it, reminders
# are still saved but never emailed.
RESEND_API_KEY=

# Must be a verified sending domain/address in your Resend account.
EMAIL_FROM=SmartRail <reminders@smartrail.in>

# Shared secret the cron sweep checks before running. Generate any random
# string (e.g. `openssl rand -hex 32`). Set the SAME value here and as a
# Vercel project env var — Vercel Cron then sends it automatically as
# "Authorization: Bearer <value>" on every scheduled hit.
CRON_SECRET=

# --- Advertising -------------------------------------------------------
# Master switch. Ads are hidden unless this is exactly "true".
# Flip to true AND set the publisher ID below, then rebuild, to show ads.
NEXT_PUBLIC_ADS_ENABLED=false

# Google AdSense publisher ID, e.g. ca-pub-1234567890123456
# Issued by AdSense after approval. With either value missing, ad slots
# render nothing at all - no empty boxes, and no ad script is fetched.
NEXT_PUBLIC_ADSENSE_CLIENT=
